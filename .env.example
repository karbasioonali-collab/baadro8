DATABASE_URL="postgresql://user:password@localhost:5432/badro?schema=public"

# رشته محرمانه برای امضای JWT نشست‌ها — حتما در production تغییر کند
AUTH_SECRET="change-me-in-production"

# provider ارسال پیامک: mock | kavenegar | melipayamak
SMS_PROVIDER="mock"

# فقط وقتی SMS_PROVIDER=kavenegar لازم است — کلید API و شماره خط ارسال کاوه‌نگار
KAVENEGAR_API_KEY="your-kavenegar-api-key"
KAVENEGAR_SENDER="your-kavenegar-sender-line"
